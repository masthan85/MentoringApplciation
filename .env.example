# Copy to .env for local runs outside Docker. Never commit real values.
ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://mentor_app:mentor_app@localhost:5432/mentor
MIGRATION_DATABASE_URL=postgresql+asyncpg://mentor:mentor@localhost:5432/mentor
REDIS_URL=redis://localhost:6379/0

# Auth. "dev" accepts locally signed tokens and is refused outside local/test.
# For a real provider (Auth0, Clerk, Entra External ID) use oidc and set the three values.
AUTH_MODE=dev
DEV_AUTH_SECRET=change-me-to-a-long-random-string
# AUTH_MODE=oidc
# AUTH_ISSUER=https://your-tenant.eu.auth0.com/
# AUTH_AUDIENCE=https://api.mentor.example
# AUTH_JWKS_URL=https://your-tenant.eu.auth0.com/.well-known/jwks.json

# Background jobs: "arq" uses the worker, "inline" runs them in the API process (no worker needed).
JOBS_MODE=inline

# Key for encrypting sensitive memories: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in staging and production; a fixed development key is used when unset.
# SENSITIVE_DATA_KEY=

# LLM providers. With LLM_DEFAULT_PROVIDER=mock no keys are needed.
LLM_DEFAULT_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Web
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
